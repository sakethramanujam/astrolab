# Copy to ~/.config/systemd/user/ (see README).
[Unit]
Description=TESS transit search nightly batch + site publish

[Service]
Type=oneshot
Nice=19
CPUWeight=20
IOSchedulingClass=idle
WorkingDirectory=%h/Documents/repos/astro-compute-lab/exoplanet_search
Environment=MAX_SECTORS=2 WORKERS=8 DEADLINE=6
ExecStart=%h/Documents/repos/astro-compute-lab/exoplanet_search/scripts/nightly.sh
TimeoutStartSec=6h
